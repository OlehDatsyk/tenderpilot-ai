# TenderPilot AI - example configuration. PLACEHOLDER VALUES ONLY - never commit a real .env file.
# The backend reads (in order, later wins): ./.env, ./backend/.env, then real environment variables.
# "Start App" scripts create backend/.env from this file and generate SECRET_KEY / ENCRYPTION_KEY for you.

# --- Core -----------------------------------------------------------------------------------------
ENVIRONMENT=development                # development | production  (production enforces safe settings)
LOG_LEVEL=INFO
# Required in production: at least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://tenderpilot:tenderpilot@127.0.0.1:5435/tenderpilot

# --- Browser access / CORS --------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # comma separated, no wildcards in production
TRUSTED_PROXY_HEADERS=false            # true behind a reverse proxy (e.g. Render) so rate limits use the client IP
DOCS_ENABLED=true                      # exposes /api/docs (OpenAPI)

# --- Authentication ---------------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REGISTRATION_ENABLED=true              # false = invitation-only
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20

# --- AI provider ------------------------------------------------------------------------------------
# none = AI disabled (the rest of the app works) | demo = rule-based demo mode, clearly labelled, no AI
# openai | anthropic | gemini = real provider (requires the matching API key)
AI_PROVIDER=demo
AI_MODEL=                              # blank = provider default (anthropic: claude-opus-5-5)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=2
AI_MAX_CONTEXT_CHARS=400000
# Lets organisation admins store their own provider key (encrypted with ENCRYPTION_KEY).
ALLOW_ORG_AI_KEYS=true
# Fernet key for encrypting stored provider keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- File storage -----------------------------------------------------------------------------------
STORAGE_BACKEND=database               # database (persistent in PostgreSQL) | local (needs a persistent disk in production)
LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_IS_PERSISTENT=false
MAX_UPLOAD_MB=20

# --- Frontend (build time, frontend/.env) -----------------------------------------------------------
# VITE_API_URL=                        # blank in development (Vite proxies /api); backend URL in production
