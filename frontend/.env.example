# Frontend build-time settings. These values are PUBLIC (embedded in the JavaScript bundle) - never put secrets here.
# Leave blank in local development: Vite proxies /api to http://127.0.0.1:8000.
# In production set it to the backend URL, e.g. https://tenderpilot-ai-api.onrender.com (a bare host name also works).
VITE_API_URL=
